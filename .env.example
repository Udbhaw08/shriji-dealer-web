# ==============================================================================
# SHRIJI DEALER FRONTEND (Vercel / Vite) — ENVIRONMENT VARIABLES
# ==============================================================================
# Add these in Vercel Dashboard -> Settings -> Environment Variables
# (Make sure to check BOTH "Production" AND "Preview" for branch test.restor.in)
# ==============================================================================

# 1. Backend Service URL
# In local dev: http://localhost:8080
# In production / preview: https://shriji-backend.onrender.com (your Render service URL)
VITE_AUTH_API_URL=http://localhost:8080

# 2. Firebase Client SDK (Phone SMS OTP & Google Popup Sign-in)
# Found in: Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# 3. Google OAuth Client ID (Optional 1-Click GIS)
VITE_GOOGLE_CLIENT_ID=

# 4. Zoho Commerce / Books API (For Vercel Serverless /api/zoho and /api/products)
ZOHO_DC=in
ZOHO_ORG_ID=60061569211
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
RESEND_API_KEY=

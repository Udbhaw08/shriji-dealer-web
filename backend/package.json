{
  "name": "shriji-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shriji Dealer Web backend — auth, roles, Zoho CRM sync, price proxy",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {

# ==============================================================================
# SHRIJI DEALER BACKEND — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Use these keys in Render Dashboard (Environment tab) or copy to backend/.env locally.
# NEVER commit the real .env file with production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & DATABASE (MANDATORY)
# ------------------------------------------------------------------------------
NODE_ENV=production
# Render automatically injects PORT (e.g. 10000), default is 8080 locally
PORT=8080

# Supabase Postgres pooled connection string (ap-south-1 Mumbai)
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# JWT signing secret (min 32 bytes)
# Generate via: node -e "console.log(crypto.randomBytes(48).toString('hex'))"
JWT_SECRET=

# Allowed frontend origins for CORS (comma-separated).
# Wildcards like *.vercel.app are supported.
FRONTEND_ORIGINS=https://restor.in,https://www.restor.in,https://test.restor.in,http://localhost:5173

# Background cron jobs (crmPoll every 5 min, catalogSync every 60 min, tokenCleanup)
# Keep "true" for production web service
ENABLE_JOBS=true
CRM_POLL_MINUTES=5
CATALOG_TTL_MINUTES=60

# ------------------------------------------------------------------------------
# 2. ZOHO INTEGRATIONS (MANDATORY FOR SYNC & CRM)
# ------------------------------------------------------------------------------
# Zoho Data Center ('in' for India zoho.in, 'com' for US)
ZOHO_DC=in

# Zoho CRM Self-Client (Dealer Accounts, Contacts, Approvals)
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_ORG_ID=

# Zoho Commerce (Product Catalog & Live Dealer Rates)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DEALER_PRICEBOOK_ID=3334672000000547177

# Webhook shared secret (Send this in Zoho CRM workflow header: X-Webhook-Secret)
WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAILS & NOTIFICATIONS
# ------------------------------------------------------------------------------
# Resend API Key (for staff invite, dealer approval, and verification emails)
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION PROVIDERS (OPTIONAL / CONDITIONAL)
# ------------------------------------------------------------------------------
# Google OAuth Client (for 1-click Google Sign-in on dealer portal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. META WHATSAPP CLOUD API (OTP AUTHENTICATION)
# ------------------------------------------------------------------------------
# Meta System User Permanent Token (with whatsapp_business_messaging permission)
WHATSAPP_TOKEN=
# Meta Phone Number ID (from WhatsApp -> API Setup in Meta Developer Dashboard)
WHATSAPP_PHONE_ID=
# Approved Authentication Template Name in Meta Business Manager (e.g. 'otp')
WHATSAPP_TEMPLATE_NAME=otp
# Template language code (e.g. 'en_US')
WHATSAPP_TEMPLATE_LANG=en_US
# Meta Graph API version (default v21.0)
WHATSAPP_GRAPH_API_VERSION=v21.0
# Whether template has Copy Code button (default true for Authentication category)
WHATSAPP_TEMPLATE_HAS_BUTTON=true


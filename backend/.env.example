# Shriji backend — copy to .env and fill in. NEVER commit .env.

# Supabase Postgres pooled connection string (Project Settings → Database → Connection string)
DATABASE_URL=

# JWT signing secret (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# Zoho CRM Self Client (dealer records + approval) — separate from the Commerce client
ZOHO_DC=in
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_ORG_ID=

# Zoho Commerce (catalog sync for the price proxy)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DEALER_PRICEBOOK_ID=3334672000000547177

# Service
PORT=8080
# Set to false to run without cron jobs (e.g. in tests)
ENABLE_JOBS=true

# Webhook shared secret (CRM workflow must send it as X-Webhook-Secret)
WEBHOOK_SECRET=

# Google OAuth (for 1-click Google Sign-in / Signup)
GOOGLE_CLIENT_ID=

# Meta WhatsApp Cloud API (1,000 free conversations/month)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Indian SMS Gateways (Optional SMS delivery)
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=

# Twilio SMS (Optional international/fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

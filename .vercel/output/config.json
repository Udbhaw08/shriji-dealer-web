{
  "version": 3,
  "routes": [
    {
      "src": "^/api(?:/(.*))$",
      "headers": {
        "Access-Control-Allow-Credentials": "true",
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET,OPTIONS,PATCH,DELETE,POST,PUT",
        "Access-Control-Allow-Headers": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization"
      },
      "continue": true
    },
    {
      "src": "^/uploads(?:/(.*))$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/banners$",
      "dest": "/api/content?scope=banners",
      "check": true
    },
    {
      "src": "^/api/schemes$",
      "dest": "/api/content?scope=schemes",
      "check": true
    },
    {
      "src": "^/api/branding$",
      "dest": "/api/content?scope=branding",
      "check": true
    },
    {
      "src": "^/uploads(?:/(.*))$",
      "dest": "/api/upload?path=$1",
      "check": true
    },
    {
      "src": "^/api/uploads$",
      "dest": "/api/upload",
      "check": true
    },
    {
      "src": "^/api/products/sync-tags$",
      "dest": "/api/products/sync-tags",
      "check": true
    },
    {
      "src": "^/api/products(?:/([^/]+?))$",
      "dest": "/api/products/[id]?id=$1",
      "check": true
    },
    {
      "src": "^/api(?:/(.*))$",
      "dest": "/api/$1",
      "check": true
    },
    {
      "src": "^/products(?:/(.+))$",
      "dest": "/api/og?slug=$1",
      "check": true
    },
    {
      "src": "^(?:/(.*))$",
      "dest": "/index.html",
      "check": true
    },
    {
      "src": "^/api/products/([^/]+)$",
      "dest": "/api/products/[id]?id=$1",
      "check": true
    },
    {
      "src": "^/api(/.*)?$",
      "status": 404
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404.html"
    },
    {
      "handle": "miss"
    },
    {
      "src": "^/api/(.+)(?:\\.(?:js))$",
      "dest": "/api/$1",
      "check": true
    }
  ],
  "framework": {
    "version": "8.3.0"
  },
  "crons": []
}

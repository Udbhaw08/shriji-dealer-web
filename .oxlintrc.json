{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "env": {
    "browser": true,
    "node": true,
    "builtin": true
  },
  "ignorePatterns": [
    "dist/**",
    ".vercel/**",
    "android/**",
    "ios/**",
    ".agents/**",
    "backend/test/**"
  ],
  "globals": {
    "Archify": "readonly"
  },
  "rules": {
    "no-undef": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  }
}
